{
  "name": "@context/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS + Fastify API: права, транзакции, переходы состояний.",
  "type": "commonjs",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "node --watch -r @swc-node/register --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "openapi": "tsx src/cli/emit-openapi.ts"
  },
  "dependencies": {
    "@context/ai": "*",
    "@context/contracts": "*",
    "@context/database": "*",
    "@context/domain": "*",
    "@context/scoring": "*",
    "@context/testing": "*",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-fastify": "12.0.3",
    "argon2": "0.45.1",
    "nodemailer": "^7.0.13",
    "pg-boss": "12.32.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@context/config": "*",
    "@nestjs/testing": "12.0.3",
    "@types/nodemailer": "^7.0.12",
    "pino-pretty": "^13.1.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}

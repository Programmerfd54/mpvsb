{
  "name": "@context/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Фоновая обработка: подсчёт, подготовка заключений, сроки, запросы на данные.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@context/ai": "*",
    "@context/contracts": "*",
    "@context/database": "*",
    "@context/domain": "*",
    "@context/scoring": "*",
    "pg-boss": "12.32.0",
    "pino": "10.3.1",
    "zod": "4.6.5",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@context/config": "*",
    "@context/testing": "*",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "@types/pg": "8.23.1"
  }
}

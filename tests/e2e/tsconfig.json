{
  "extends": "@context/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "allowJs": false
  },
  "include": ["**/*.ts", "../../playwright.config.ts"],
  "exclude": ["node_modules"]
}

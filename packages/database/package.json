{
  "name": "@context/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, SQL-миграции, роли БД, RLS и tenant-транзакции.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "migrate": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts",
    "reset": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts --reset",
    "seed:demo": "tsx --env-file-if-exists=../../.env src/cli/seed-demo.ts"
  },
  "dependencies": {
    "@context/contracts": "*",
    "@context/domain": "*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.4.2",
    "pg": "8.23.0",
    "pg-boss": "12.32.0"
  },
  "devDependencies": {
    "@context/config": "*",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "@context/scoring": "*",
    "@context/testing": "*",
    "argon2": "0.45.1"
  }
}

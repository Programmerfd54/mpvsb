generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["core", "identity", "platform"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model access_grants {
  id                     String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organization_id        String          @db.Uuid
  grantee_user_id        String          @db.Uuid
  purpose                String
  resource_scope         Json            @default("{}")
  permissions            String[]        @default([])
  reason                 String
  state                  String          @default("requested")
  requested_by           String          @db.Uuid
  requested_at           DateTime        @default(now()) @db.Timestamptz(6)
  approved_by            String?         @db.Uuid
  approved_at            DateTime?       @db.Timestamptz(6)
  expires_at             DateTime?       @db.Timestamptz(6)
  revoked_at             DateTime?       @db.Timestamptz(6)
  decision_note          String?
  created_at             DateTime        @default(now()) @db.Timestamptz(6)
  updated_at             DateTime        @default(now()) @db.Timestamptz(6)
  extends_grant_id       String?         @db.Uuid
  requested_hours        Int?            @db.SmallInt
  approver               users?          @relation("access_grants_approved_byTousers", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  extends_grant_same_org access_grants?  @relation("access_grants_organization_id_extends_grant_idToaccess_grants", fields: [organization_id, extends_grant_id], references: [organization_id, id], onDelete: NoAction, onUpdate: NoAction, map: "access_grants_extends_same_org_fk")
  extensions_same_org    access_grants[] @relation("access_grants_organization_id_extends_grant_idToaccess_grants")
  grantee                users           @relation("access_grants_grantee_user_idTousers", fields: [grantee_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations          organizations   @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  requester              users           @relation("access_grants_requested_byTousers", fields: [requested_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organization_id, id])
  @@index([organization_id, grantee_user_id, state, expires_at], map: "access_grants_active_idx")
  @@index([extends_grant_id], map: "access_grants_extends_idx", where: raw("(extends_grant_id IS NOT NULL)"))
  @@index([organization_id, state, requested_at(sort: Desc)], map: "access_grants_org_state_idx")
  @@schema("core")
}


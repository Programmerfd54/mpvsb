# Пример окружения для infra/compose.app.yaml. Реальные значения не коммитятся.
# Скопируйте в .env.app в корне репозитория и заполните. В production значения
# приходят из secret manager, а не из файла рядом с кодом.
#
#   cp infra/app.env.example .env.app
#   docker compose -f infra/compose.app.yaml --env-file .env.app up -d

APP_ENV=production

# --- Подключения к базе ---
# Владелец схемы. Применяет миграции и задаёт пароли runtime-ролей. Приложение им не работает.
DATABASE_URL_MIGRATOR=postgresql://context_owner:REPLACE_ME@db.example.internal:5432/context
# Runtime-роли: без BYPASSRLS и без прав на DDL.
DATABASE_URL_API=postgresql://context_api:REPLACE_ME@db.example.internal:5432/context
DATABASE_URL_WORKER=postgresql://context_worker:REPLACE_ME@db.example.internal:5432/context

# Пароли runtime-ролей. Их выставляет команда migrate при запуске.
DB_PASSWORD_API=REPLACE_ME
DB_PASSWORD_WORKER=REPLACE_ME
DB_PASSWORD_EVALUATOR=REPLACE_ME

# --- Приложение ---
# Внешний origin интерфейса. Проверка CSRF по Origin сравнивает с ним.
WEB_ORIGIN=https://context.example.org
# 32+ случайных байта в base64: HMAC хэшей токенов приглашений и сессий.
TOKEN_HASH_SECRET=REPLACE_ME_WITH_32_RANDOM_BYTES_BASE64
COOKIE_SECURE=true
REPORT_PROVIDER=fake
LOG_LEVEL=info

# --- Публикация портов на хосте (локальная проверка) ---
API_PUBLISHED_PORT=3101
WEB_PUBLISHED_PORT=3100

# --- Только для профиля local-db (отдельная временная база рядом с приложением) ---
# POSTGRES_PASSWORD=REPLACE_ME
# POSTGRES_PUBLISHED_PORT=55444

# Пример окружения. Реальные значения не коммитятся.
# Скопируйте в .env и заполните. В production значения приходят из secret manager.

# Режим приложения задаётся только здесь. NODE_ENV выставляет сама сборка:
# значение development в окружении ломает production-сборку Next.
APP_ENV=development

# --- PostgreSQL ---
# Владелец схемы. Применяет миграции, создаёт runtime-роли. Приложение им не работает.
DATABASE_URL_MIGRATOR=postgresql://context_owner:context_local_dev@127.0.0.1:55442/context
# Runtime-роли: без BYPASSRLS, без прав на DDL.
DATABASE_URL_API=postgresql://context_api:REPLACE_ME@127.0.0.1:55442/context
DATABASE_URL_WORKER=postgresql://context_worker:REPLACE_ME@127.0.0.1:55442/context
# Единственная роль с доступом к исходам исследования.
DATABASE_URL_EVALUATOR=postgresql://context_evaluator:REPLACE_ME@127.0.0.1:55442/context

# Пароли runtime-ролей. Скрипт миграции выставляет их при запуске.
DB_PASSWORD_API=REPLACE_ME
DB_PASSWORD_WORKER=REPLACE_ME
DB_PASSWORD_EVALUATOR=REPLACE_ME

# --- Тестовая база (integration-тесты, tmpfs) ---
TEST_DATABASE_URL_MIGRATOR=postgresql://context_owner:context_local_dev@127.0.0.1:55443/context_test
TEST_DATABASE_URL_API=postgresql://context_api:REPLACE_ME@127.0.0.1:55443/context_test
TEST_DATABASE_URL_WORKER=postgresql://context_worker:REPLACE_ME@127.0.0.1:55443/context_test
TEST_DATABASE_URL_EVALUATOR=postgresql://context_evaluator:REPLACE_ME@127.0.0.1:55443/context_test

# --- Приложение ---
API_PORT=3001
# Адрес прослушивания API. По умолчанию 127.0.0.1: наружу API выходит через общий
# reverse proxy. Принимается только IP-адрес (в контейнере — 0.0.0.0); имя хоста,
# в том числе localhost, схема конфигурации отвергает при старте.
# API_HOST=127.0.0.1
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:3001
# 32+ случайных байта в base64. Используется для HMAC хэшей токенов приглашений.
TOKEN_HASH_SECRET=REPLACE_ME_WITH_32_RANDOM_BYTES_BASE64
# Отдельный ключ шифрования SMTP-пароля. Минимум 32 символа.
MAIL_CONFIG_ENCRYPTION_KEY=
# Cookie в dev по HTTP используют отдельные имена и не ослабляют production defaults.
COOKIE_SECURE=false

# --- Однократная подготовка пространства (`npm run db:bootstrap`) ---
BOOTSTRAP_ORGANIZATION_NAME=ООО Контекст
BOOTSTRAP_ORGANIZATION_CODE=context
BOOTSTRAP_ORGANIZATION_TIMEZONE=Europe/Moscow
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_NAME=Технический администратор
# В production/staging обязателен. В development без него команда один раз
# сгенерирует пароль и покажет только в терминале.
BOOTSTRAP_ADMIN_PASSWORD=

# --- Подготовка заключений ---
# fake — только demo; template — структурированная записка по правилам.
# Реальный провайдер не включается, пока не пройдены проверки готовности.
REPORT_PROVIDER=fake
REPORT_PROVIDER_TIMEOUT_MS=60000

# --- Внутренний сервис исходов ---
EVALUATOR_PORT=3002
EVALUATOR_INTERNAL_URL=http://127.0.0.1:3002
# Ключ подписи короткоживущего внутреннего контекста. Недоступен worker-процессу.
EVALUATOR_SIGNING_KEY=REPLACE_ME_WITH_32_RANDOM_BYTES_BASE64
